# Optional settings. Nothing here is secret and no keys are needed: everything runs offline.
# Nothing loads this file automatically; export the variables in your shell if you want them.

# Wallet database file for `uvicorn wallet.api:app` (created and seeded on first request).
WALLET_DB_PATH=data/wallet.db

# Seed the wallet is filled from when the database is empty.
WALLET_SEED_PATH=data/wallet_seed.json

# Instagram direct messages on the WhatsApp app (channels/instagram/README.md). Secrets: set them in the
# environment of the service, never in a file. With any of the first four empty, /instagram/webhook is 404.
INSTAGRAM_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_API_BASE=
INSTAGRAM_API_VERSION=
# Wrong link codes from all senders in an hour before guessers are held (default 100, 0 = off).
INSTAGRAM_LINK_FLOOD_PER_HOUR=

# «شلون تأكدت؟» under every confirmation card (1, the default) or not (0).
CARD_WHY_BUTTON=
