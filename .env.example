# Optional settings. Nothing here is secret and no keys are needed: everything runs offline.
# Nothing loads this file automatically; export the variables in your shell if you want them.

# Wallet database file for `uvicorn wallet.api:app` (created and seeded on first request).
WALLET_DB_PATH=data/wallet.db

# Seed the wallet is filled from when the database is empty.
WALLET_SEED_PATH=data/wallet_seed.json
