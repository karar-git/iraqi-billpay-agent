# secrets (none are needed, but never commit one)
.env

# local wallet databases (created by `uvicorn wallet.api:app` or the seed CLI)
*.db
*.db-wal
*.db-shm
*.db-journal

# the WhatsApp channel's local state (DATA_DIR defaults to data/)
data/whatsapp/

# Python
__pycache__/
.pytest_cache/
.venv/

# evaluation output
eval/results*
results*.json

# raw text-to-speech audio behind data/voice/billpay (the .ogg notes are committed)
data/voice/billpay/.pcm/
